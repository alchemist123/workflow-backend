# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in real values.  Generated: every key below is here
# because some node in this workflow needs it, noted in the comment.
# Never commit a populated .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Serving ──────────────────────────────────────────────────────────────────
PORT=8080

# ── Agent identity (advertised on the agent card) ───────────────────────────
AGENT_NAME=text_triage
AGENT_DESCRIPTION=Triages inbound text by length and returns a summary.
AGENT_VERSION=1.0.0

# Public base URL other agents use to reach this one.  On Cloud Run this is the
# service URL; locally, leave blank to fall back to http://localhost:${PORT}.
CLOUD_RUN_URL=

# ── Inbound auth ─────────────────────────────────────────────────────────────
# When set, callers must send `Authorization: Bearer <token>`.
# Leave blank only for local development.
A2A_AUTH_TOKEN=

# ── A2A task persistence ─────────────────────────────────────────────────────
# Blank = in-memory: `tasks/get` then only works inside one process and
# in-flight tasks are lost on restart.  Set a SQLAlchemy async DSN to persist.
# TASK_STORE_DSN=postgresql+asyncpg://user:pass@host:5432/tasks
TASK_STORE_DSN=

# ── Google / Vertex AI ───────────────────────────────────────────────────────
# Required by: agent nodes (this example workflow has none, so these are unused
# and safe to leave blank -- the generator omits them when no node needs them).
GOOGLE_CLOUD_PROJECT=
VERTEX_AI_LOCATION=us-central1
LLM_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Auth: on Cloud Run use the service identity; locally run
#   gcloud auth application-default login
# Or paste a service account key as one line:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# An AI Studio key instead of Vertex AI (development only):
# GOOGLE_API_KEY=
