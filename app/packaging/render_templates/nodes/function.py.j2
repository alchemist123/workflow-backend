log = node_logger(NODE_ID)


def _run(data: dict):
    """The canvas function body, emitted as ordinary Python.

    Trust boundary: this code came from whoever built the canvas and runs with
    the package's own privileges. The container is the boundary — treat canvas
    authorship as equivalent to commit access to this package.
    """
    result = None
{{ python_body }}
    return result


@node(name=NODE_ID, **NODE_KWARGS({{ node_kwargs }}))
async def {{ node.name }}(ctx: Context, node_input=None):
    data = node_input or {}
    try:
        result = _run(data)
    except Exception as exc:  # noqa: BLE001
        if ON_ERROR != "continue":
            raise
        return node_error(NODE_ID, exc)

    payload = result if isinstance(result, dict) else {"result": result}
    log.info("produced %d key(s)", len(payload))
    merge_state(ctx, payload)
    return Event(output={**data, **payload})
