from google.adk import Event
from google.adk.agents.context import Context

from core.config import settings
from core.logging import node_logger
from core.state import merge_state
from nodes.base import NODE_KWARGS, flow_node, node_error
from tools import mcp as mcp_tools

NODE_ID = {{ node.name | tojson }}
# Name this node saves its result under, for later nodes to read.
OUTPUT_VARIABLE = {{ output_variable | tojson }}
ON_ERROR = {{ node.on_error | tojson }}

TOOL_NAME = {{ tool_name | tojson }}
# Static arguments from the canvas; the incoming payload is merged over them.
STATIC_ARGS: dict = {{ static_args | pyliteral }}

# The URL and token come from the environment, with no literal fallback: an MCP
# URL can embed basic-auth credentials, and this file is committed to git. The
# canvas value is written into `.env` (gitignored) as this variable's default.
URL_ENV_KEY = {{ url_env_key | tojson }}
TOKEN_ENV_KEY = {{ token_env_key | tojson }}

log = node_logger(NODE_ID)


def _url() -> str:
    return settings.env_value(URL_ENV_KEY)


def _headers() -> dict[str, str]:
    token = settings.env_value(TOKEN_ENV_KEY)
    return {"Authorization": f"Bearer {token}"} if token else {}


@flow_node(name=NODE_ID, variable=OUTPUT_VARIABLE, **NODE_KWARGS({{ node_kwargs }}))
async def {{ node.name }}(ctx: Context, node_input=None):
    data = node_input or {}
    url = _url()
    if not url:
        message = f"{NODE_ID}: no MCP server URL. Set {URL_ENV_KEY} in .env."
        if ON_ERROR != "continue":
            raise ValueError(message)
        return node_error(NODE_ID, ValueError(message))

    arguments = {**STATIC_ARGS, **data}
    log.info("calling MCP tool %r", TOOL_NAME)
    try:
        result = await mcp_tools.call_tool(url, TOOL_NAME, arguments, _headers())
    except Exception as exc:  # noqa: BLE001
        if ON_ERROR != "continue":
            raise
        return node_error(NODE_ID, exc)

    if "error" in result and ON_ERROR != "continue":
        raise RuntimeError(f"{NODE_ID}: {result['error']}")

    merge_state(ctx, result)
    return Event(output={**data, **result})
