{% include "nodes/_header.j2" %}
{% if mode == "jmespath" %}
import jmespath
{% elif mode == "jinja2" %}
from jinja2.sandbox import SandboxedEnvironment
{% endif %}
from google.adk import Event
from google.adk.agents.context import Context

from core.logging import node_logger
{% if mode == "fields" %}
from core.mapping import build as build_mapping
{% endif %}
from core.state import merge_state
from core.variables import all_variables
from nodes.base import NODE_KWARGS, flow_node, node_error

NODE_ID = {{ node.name | tojson }}
# Name this node saves its result under, for later nodes to read.
OUTPUT_VARIABLE = {{ output_variable | tojson }}
ON_ERROR = {{ node.on_error | tojson }}
{% if mode == "jmespath" %}
EXPRESSION = {{ expression | tojson }}
{% elif mode == "jinja2" %}
TEMPLATE = {{ expression | tojson }}
{% elif mode == "fields" %}
# The output shape, declared on the canvas. Each entry says where its value
# comes from, so the mapping is data rather than code.
OUTPUT_FIELDS: list[dict] = {{ output_fields | pyliteral }}
{% endif %}
{% if output_key %}
OUTPUT_KEY = {{ output_key | tojson }}
{% endif %}

log = node_logger(NODE_ID)


def _transform(data: dict, vars: dict) -> dict:  # noqa: A002 - `vars` is the canvas name
    """The canvas expression, emitted as ordinary Python.

    `data` is the payload from the previous node; `vars` is every variable a
    node has named, keyed by that name.
    """
{% if mode == "jmespath" %}
    found = jmespath.search(EXPRESSION, data)
{% if output_key %}
    return {OUTPUT_KEY: found} if found is not None else {}
{% else %}
    if isinstance(found, dict):
        return found
    return {"result": found} if found is not None else {}
{% endif %}
{% elif mode == "jinja2" %}
    rendered = SandboxedEnvironment().from_string(TEMPLATE).render(vars=vars, **data)
    import json

    try:
        parsed = json.loads(rendered)
    except ValueError:
        return {"result": rendered}
    return parsed if isinstance(parsed, dict) else {"result": parsed}
{% elif mode == "fields" %}
    return build_mapping(OUTPUT_FIELDS, data, vars, where=NODE_ID)
{% else %}
    result = None
{{ python_body }}
    if isinstance(result, dict):
        return result
    return {"result": result} if result is not None else {}
{% endif %}


@flow_node(name=NODE_ID, variable=OUTPUT_VARIABLE, **NODE_KWARGS({{ node_kwargs }}))
async def {{ node.name }}(ctx: Context, node_input=None):
    data = node_input or {}
    try:
        result = _transform(data, all_variables(ctx))
    except Exception as exc:  # noqa: BLE001
        if ON_ERROR != "continue":
            raise
        return node_error(NODE_ID, exc)

    log.info("transformed %d key(s) into %d", len(data), len(result))
    merge_state(ctx, result)
    return Event(output={**data, **result})
    
