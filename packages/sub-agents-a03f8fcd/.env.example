# ─────────────────────────────────────────────────────────────────────────────
# Sub Agents
#
# Copy to .env and fill in real values. Every key below is here because some
# part of this workflow needs it — the comment says which.
#
# Credentials are left blank here on purpose: this file is committed, and the
# canvas values are pre-filled in .env instead, which .gitignore excludes.
# ─────────────────────────────────────────────────────────────────────────────

# ── Serving ──
# Port the agent listens on.
# Needed by: serving  (optional)
PORT=8080

# ── Agent identity ──
# Advertised agent name.
# Needed by: agent_card
AGENT_NAME=sub_agents
# Advertised description.
# Needed by: agent_card
AGENT_DESCRIPTION=
# Advertised version.
# Needed by: agent_card
AGENT_VERSION=1.0.0
# Public base URL; becomes the agent card's url. Blank falls back to localhost.
# Needed by: agent_card  (optional)
CLOUD_RUN_URL=

# ── Inbound auth ──
# When set, callers must send this as a bearer token and the agent card advertises that it is required.
# Needed by: inbound_auth  (optional)  — credential
A2A_AUTH_TOKEN=

# ── Task persistence ──
# SQLAlchemy async DSN. Blank uses an in-memory store, so tasks/get only works within one process and in-flight tasks are lost on restart.
# Needed by: task_persistence  (optional)  — credential
TASK_STORE_DSN=

# ── Google / Vertex AI ──
# GCP project for Vertex AI.
# Needed by: n_orchestrator_agent_2
GOOGLE_CLOUD_PROJECT=
# Vertex AI region.
# Needed by: n_orchestrator_agent_2  (optional)
VERTEX_AI_LOCATION=us-central1
# Default model.
# Needed by: n_orchestrator_agent_2  (optional)
LLM_MODEL=gemini-2.5-flash
# TRUE routes through Vertex AI; unset uses an AI Studio key.
# Needed by: n_orchestrator_agent_2  (optional)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# Service account key as one line. Blank uses Application Default Credentials, which is the usual choice on Cloud Run.
# Needed by: n_orchestrator_agent_2  (optional)  — credential
GOOGLE_SERVICE_ACCOUNT_JSON=
# AI Studio key, as an alternative to Vertex AI for local development.
# Needed by: n_orchestrator_agent_2  (optional)  — credential
GOOGLE_API_KEY=

# ── MCP servers ──
# MCP server URL for 'Grammar MCP'.
# Needed by: n_orchestrator_agent_2  — credential
MCP_GRAMMAR_MCP_URL=
# Bearer token for 'Grammar MCP', if it needs one.
# Needed by: n_orchestrator_agent_2  (optional)  — credential
MCP_GRAMMAR_MCP_TOKEN=
# MCP server URL for 'Weather MCP'.
# Needed by: n_orchestrator_agent_2  — credential
MCP_WEATHER_MCP_URL=
# Bearer token for 'Weather MCP', if it needs one.
# Needed by: n_orchestrator_agent_2  (optional)  — credential
MCP_WEATHER_MCP_TOKEN=
# MCP transport for every configured server.
# Needed by: n_orchestrator_agent_2  (optional)
MCP_TRANSPORT=streamable_http

# ── Google auth ──
# On Cloud Run the service identity is used automatically.
# Locally, run once:  gcloud auth application-default login
# Or set GOOGLE_SERVICE_ACCOUNT_JSON above to a service account key on one line.
