{
  "schema_version": 1,
  "workflow": {
    "name": "Sub Agents",
    "slug": "sub_agents",
    "description": "LLM agents used as sub-agents, with declared input and output structures.",
    "version_id": "a03f8fcd-fb8f-4525-89c8-c0f1f6e78d7c",
    "canvas_version": 5
  },
  "entry_node": "a2a_start",
  "terminal_node": "n_end_1",
  "nodes": [
    {
      "name": "a2a_start",
      "canvas_id": "trigger",
      "type": "A2A_START",
      "module": "nodes.a2a_start",
      "title": "A2A Start",
      "timeout": 120,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "input_mode": "json",
        "state_key": "wf",
        "payload_schema": {
          "fields": [
            {
              "name": "request",
              "type": "text",
              "description": "What the user wants planned or written",
              "required": true
            }
          ]
        }
      },
      "is_entry": true
    },
    {
      "name": "n_end_1",
      "canvas_id": "end",
      "type": "END",
      "module": "nodes.n_end_1",
      "title": "End",
      "timeout": 120,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "output_mapping": {
          "result": "answer"
        }
      },
      "is_terminal": true
    },
    {
      "name": "n_orchestrator_agent_2",
      "canvas_id": "orchestrator",
      "type": "ORCHESTRATOR_AGENT",
      "module": "nodes.n_orchestrator_agent_2",
      "title": "Orchestrator",
      "timeout": 120,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "model": "gemini-2.5-flash",
        "system_prompt": "Answer the user's request. You can call a trip planner and a polish pipeline. Pass them proper arguments \u2014 they declare what they need.",
        "resolved_tools": {
          "mcp_servers": [],
          "a2a_agents": [],
          "functions": [],
          "groups": [
            {
              "kind": "group",
              "name": "polish_text",
              "mode": "sequential",
              "description": "Check grammar, then rewrite the text in a house style.",
              "stop_on_error": true,
              "max_concurrency": 0,
              "children": [
                {
                  "kind": "mcp",
                  "name": "Grammar MCP",
                  "transport": "http",
                  "tool_name": "check_grammar",
                  "node_id": "grammar",
                  "node_type": "TOOL",
                  "url_env": "MCP_GRAMMAR_MCP_URL",
                  "auth_token_env": "MCP_GRAMMAR_MCP_TOKEN"
                },
                {
                  "kind": "agent",
                  "name": "editor",
                  "description": "Rewrites text in a consistent house style.",
                  "instruction": "Rewrite the text clearly and concisely.",
                  "provider": "vertex_ai",
                  "model": "gemini-2.5-flash",
                  "temperature": null,
                  "max_tokens": null,
                  "input_schema": {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string",
                        "description": "The text to rewrite"
                      },
                      "style": {
                        "type": "string",
                        "description": "House style to apply"
                      }
                    },
                    "required": [
                      "text"
                    ]
                  },
                  "output_schema": {
                    "type": "object",
                    "properties": {
                      "rewritten": {
                        "type": "string",
                        "description": "The rewritten text"
                      }
                    },
                    "required": [
                      "rewritten"
                    ]
                  },
                  "output_key": "",
                  "tools": {
                    "mcp_servers": [],
                    "a2a_agents": [],
                    "functions": [],
                    "groups": [],
                    "agents": []
                  },
                  "node_id": "editor",
                  "node_type": "LLM_AGENT"
                }
              ],
              "node_id": "polish",
              "node_type": "SEQUENTIAL_AGENT"
            }
          ],
          "agents": [
            {
              "kind": "agent",
              "name": "trip_planner",
              "description": "Plans a short trip for a city and a number of days.",
              "instruction": "Plan a trip. Use the weather tool before recommending outdoor activities.",
              "provider": "vertex_ai",
              "model": "gemini-2.5-flash",
              "temperature": null,
              "max_tokens": null,
              "input_schema": {
                "type": "object",
                "properties": {
                  "city": {
                    "type": "string",
                    "description": "Destination city"
                  },
                  "days": {
                    "type": "integer",
                    "description": "Trip length in days"
                  },
                  "interests": {
                    "type": "string",
                    "description": "What the traveller enjoys"
                  }
                },
                "required": [
                  "city",
                  "days"
                ]
              },
              "output_schema": {
                "type": "object",
                "properties": {
                  "itinerary": {
                    "type": "string",
                    "description": "Day-by-day plan"
                  },
                  "packing_list": {
                    "type": "array",
                    "description": "What to bring"
                  }
                },
                "required": [
                  "itinerary"
                ]
              },
              "output_key": "trip",
              "tools": {
                "mcp_servers": [
                  {
                    "kind": "mcp",
                    "name": "Weather MCP",
                    "transport": "http",
                    "tool_name": "get_forecast",
                    "node_id": "weather",
                    "node_type": "TOOL",
                    "url_env": "MCP_WEATHER_MCP_URL",
                    "auth_token_env": "MCP_WEATHER_MCP_TOKEN"
                  }
                ],
                "a2a_agents": [],
                "functions": [],
                "groups": [],
                "agents": []
              },
              "node_id": "planner",
              "node_type": "LLM_AGENT"
            }
          ]
        }
      }
    }
  ],
  "edges": [
    {
      "from": "START",
      "to": "a2a_start",
      "route": null
    },
    {
      "from": "a2a_start",
      "to": "n_orchestrator_agent_2",
      "route": null
    },
    {
      "from": "n_orchestrator_agent_2",
      "to": "n_end_1",
      "route": null
    }
  ],
  "join_nodes": [],
  "env_keys": [
    {
      "key": "PORT",
      "required": false,
      "needed_by": [
        "serving"
      ],
      "default": "8080",
      "description": "Port the agent listens on."
    },
    {
      "key": "AGENT_NAME",
      "required": true,
      "needed_by": [
        "agent_card"
      ],
      "default": "sub_agents",
      "description": "Advertised agent name."
    },
    {
      "key": "AGENT_DESCRIPTION",
      "required": true,
      "needed_by": [
        "agent_card"
      ],
      "description": "Advertised description."
    },
    {
      "key": "AGENT_VERSION",
      "required": true,
      "needed_by": [
        "agent_card"
      ],
      "default": "1.0.0",
      "description": "Advertised version."
    },
    {
      "key": "CLOUD_RUN_URL",
      "required": false,
      "needed_by": [
        "agent_card"
      ],
      "default": "",
      "description": "Public base URL; becomes the agent card's url. Blank falls back to localhost."
    },
    {
      "key": "A2A_AUTH_TOKEN",
      "required": false,
      "needed_by": [
        "inbound_auth"
      ],
      "description": "When set, callers must send this as a bearer token and the agent card advertises that it is required.",
      "secret": true
    },
    {
      "key": "TASK_STORE_DSN",
      "required": false,
      "needed_by": [
        "task_persistence"
      ],
      "description": "SQLAlchemy async DSN. Blank uses an in-memory store, so tasks/get only works within one process and in-flight tasks are lost on restart.",
      "secret": true
    },
    {
      "key": "GOOGLE_CLOUD_PROJECT",
      "required": true,
      "needed_by": [
        "n_orchestrator_agent_2"
      ],
      "default": "",
      "description": "GCP project for Vertex AI."
    },
    {
      "key": "VERTEX_AI_LOCATION",
      "required": false,
      "needed_by": [
        "n_orchestrator_agent_2"
      ],
      "default": "us-central1",
      "description": "Vertex AI region."
    },
    {
      "key": "LLM_MODEL",
      "required": false,
      "needed_by": [
        "n_orchestrator_agent_2"
      ],
      "default": "gemini-2.5-flash",
      "description": "Default model."
    },
    {
      "key": "GOOGLE_GENAI_USE_VERTEXAI",
      "required": false,
      "needed_by": [
        "n_orchestrator_agent_2"
      ],
      "default": "TRUE",
      "description": "TRUE routes through Vertex AI; unset uses an AI Studio key."
    },
    {
      "key": "GOOGLE_SERVICE_ACCOUNT_JSON",
      "required": false,
      "needed_by": [
        "n_orchestrator_agent_2"
      ],
      "description": "Service account key as one line. Blank uses Application Default Credentials, which is the usual choice on Cloud Run.",
      "secret": true
    },
    {
      "key": "GOOGLE_API_KEY",
      "required": false,
      "needed_by": [
        "n_orchestrator_agent_2"
      ],
      "description": "AI Studio key, as an alternative to Vertex AI for local development.",
      "secret": true
    },
    {
      "key": "MCP_GRAMMAR_MCP_URL",
      "required": true,
      "needed_by": [
        "n_orchestrator_agent_2"
      ],
      "description": "MCP server URL for 'Grammar MCP'.",
      "secret": true
    },
    {
      "key": "MCP_GRAMMAR_MCP_TOKEN",
      "required": false,
      "needed_by": [
        "n_orchestrator_agent_2"
      ],
      "description": "Bearer token for 'Grammar MCP', if it needs one.",
      "secret": true
    },
    {
      "key": "MCP_WEATHER_MCP_URL",
      "required": true,
      "needed_by": [
        "n_orchestrator_agent_2"
      ],
      "description": "MCP server URL for 'Weather MCP'.",
      "secret": true
    },
    {
      "key": "MCP_WEATHER_MCP_TOKEN",
      "required": false,
      "needed_by": [
        "n_orchestrator_agent_2"
      ],
      "description": "Bearer token for 'Weather MCP', if it needs one.",
      "secret": true
    },
    {
      "key": "MCP_TRANSPORT",
      "required": false,
      "needed_by": [
        "n_orchestrator_agent_2"
      ],
      "default": "streamable_http",
      "description": "MCP transport for every configured server."
    }
  ]
}
