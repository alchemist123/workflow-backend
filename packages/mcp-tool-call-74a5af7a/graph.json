{
  "schema_version": 1,
  "workflow": {
    "name": "MCP Tool Call",
    "slug": "mcp_tool_call",
    "description": "Calls one tool on an MCP server as a step in the flow, with its arguments mapped from what earlier nodes produced.",
    "version_id": "74a5af7a-9f84-4edb-8903-fb6081561090",
    "canvas_version": 7
  },
  "entry_node": "a2a_start",
  "terminal_node": "n_end_1",
  "nodes": [
    {
      "name": "a2a_start",
      "canvas_id": "trigger",
      "type": "A2A_START",
      "module": "nodes.a2a_start",
      "title": "Order",
      "timeout": 60,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "input_mode": "json",
        "state_key": "wf",
        "output_variable": "order",
        "payload_schema": {
          "fields": [
            {
              "name": "item",
              "type": "string",
              "description": "What was ordered",
              "required": true
            },
            {
              "name": "count",
              "type": "integer",
              "description": "How many",
              "required": true
            }
          ]
        }
      },
      "is_entry": true
    },
    {
      "name": "n_end_1",
      "canvas_id": "done",
      "type": "END",
      "module": "nodes.n_end_1",
      "title": "Done",
      "timeout": 60,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "output_mapping": {}
      },
      "is_terminal": true
    },
    {
      "name": "n_mcp_tool_4",
      "canvas_id": "quote",
      "type": "MCP_TOOL",
      "module": "nodes.n_mcp_tool_4",
      "title": "Price Quote",
      "timeout": 60,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "tool_name": "price_quote",
        "tool_description": "Quote a price for a SKU and quantity.",
        "tool_schema": {
          "type": "object",
          "properties": {
            "sku": {
              "type": "string"
            },
            "quantity": {
              "type": "integer"
            },
            "currency": {
              "type": "string"
            }
          },
          "required": [
            "sku",
            "quantity"
          ]
        },
        "arg_mode": "fields",
        "output_variable": "quote",
        "arg_fields": [
          {
            "name": "sku",
            "type": "string",
            "source": "data.code",
            "required": true
          },
          {
            "name": "quantity",
            "type": "integer",
            "source": "data.units",
            "required": true
          },
          {
            "name": "currency",
            "type": "string",
            "default": "GBP"
          }
        ],
        "_env": {
          "mcp_url": "MCP_PRICE_QUOTE_URL",
          "auth_token": "MCP_PRICE_QUOTE_TOKEN"
        }
      }
    },
    {
      "name": "n_transform_2",
      "canvas_id": "invoice",
      "type": "TRANSFORM",
      "module": "nodes.n_transform_2",
      "title": "Invoice Line",
      "timeout": 60,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "mode": "fields",
        "output_fields": [
          {
            "name": "description",
            "type": "string",
            "source": "data.sku",
            "required": true
          },
          {
            "name": "quantity",
            "type": "integer",
            "source": "data.quantity",
            "required": true
          },
          {
            "name": "amount",
            "type": "number",
            "source": "data.total",
            "required": true
          },
          {
            "name": "currency",
            "type": "string",
            "source": "data.currency"
          },
          {
            "name": "ordered_as",
            "type": "string",
            "source": "vars.order.item"
          }
        ]
      }
    },
    {
      "name": "n_transform_3",
      "canvas_id": "normalise",
      "type": "TRANSFORM",
      "module": "nodes.n_transform_3",
      "title": "Normalise",
      "timeout": 60,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "mode": "fields",
        "output_variable": "normalised",
        "output_fields": [
          {
            "name": "code",
            "type": "string",
            "source": "data.item",
            "required": true
          },
          {
            "name": "units",
            "type": "integer",
            "source": "data.count",
            "required": true
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "START",
      "to": "a2a_start",
      "route": null
    },
    {
      "from": "a2a_start",
      "to": "n_transform_3",
      "route": null
    },
    {
      "from": "n_mcp_tool_4",
      "to": "n_transform_2",
      "route": null
    },
    {
      "from": "n_transform_2",
      "to": "n_end_1",
      "route": null
    },
    {
      "from": "n_transform_3",
      "to": "n_mcp_tool_4",
      "route": null
    }
  ],
  "join_nodes": [],
  "env_keys": [
    {
      "key": "PORT",
      "required": false,
      "needed_by": [
        "serving"
      ],
      "default": "8080",
      "description": "Port the agent listens on."
    },
    {
      "key": "AGENT_NAME",
      "required": true,
      "needed_by": [
        "agent_card"
      ],
      "default": "mcp_tool_call",
      "description": "Advertised agent name."
    },
    {
      "key": "AGENT_DESCRIPTION",
      "required": true,
      "needed_by": [
        "agent_card"
      ],
      "description": "Advertised description."
    },
    {
      "key": "AGENT_VERSION",
      "required": true,
      "needed_by": [
        "agent_card"
      ],
      "default": "1.0.0",
      "description": "Advertised version."
    },
    {
      "key": "CLOUD_RUN_URL",
      "required": false,
      "needed_by": [
        "agent_card"
      ],
      "default": "",
      "description": "Public base URL; becomes the agent card's url. Blank falls back to localhost."
    },
    {
      "key": "A2A_AUTH_TOKEN",
      "required": false,
      "needed_by": [
        "inbound_auth"
      ],
      "description": "When set, callers must send this as a bearer token and the agent card advertises that it is required.",
      "secret": true
    },
    {
      "key": "TASK_STORE_DSN",
      "required": false,
      "needed_by": [
        "task_persistence"
      ],
      "description": "SQLAlchemy async DSN. Blank uses an in-memory store, so tasks/get only works within one process and in-flight tasks are lost on restart.",
      "secret": true
    },
    {
      "key": "MCP_PRICE_QUOTE_URL",
      "required": true,
      "needed_by": [
        "n_mcp_tool_4"
      ],
      "description": "MCP server URL for 'Price Quote'.",
      "secret": true
    },
    {
      "key": "MCP_PRICE_QUOTE_TOKEN",
      "required": false,
      "needed_by": [
        "n_mcp_tool_4"
      ],
      "description": "Bearer token for 'Price Quote', if it needs one.",
      "secret": true
    },
    {
      "key": "MCP_TRANSPORT",
      "required": false,
      "needed_by": [
        "n_mcp_tool_4"
      ],
      "default": "streamable_http",
      "description": "MCP transport for every configured server."
    }
  ]
}
