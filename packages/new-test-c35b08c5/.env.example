# Copy this file to .env and fill in your real values before running.
GOOGLE_CLOUD_PROJECT=my-gcp-project-id
VERTEX_LOCATION=us-central1

# Auth — gcloud ADC is mounted automatically via docker-compose.yml volumes.
# Run once on your host: gcloud auth application-default login
# To use a service account key instead, set GOOGLE_SERVICE_ACCOUNT_JSON (single-line JSON):
# GOOGLE_SERVICE_ACCOUNT_JSON={...}
