{
  "schema_version": 1,
  "workflow": {
    "name": "Field Mapping",
    "slug": "field_mapping",
    "description": "Transforms that declare the shape they build and pick each field's source from what is actually available upstream.",
    "version_id": "364fe8d7-c6ad-4dbd-9608-6282e0e1d398",
    "canvas_version": 6
  },
  "entry_node": "a2a_start",
  "terminal_node": "n_end_1",
  "nodes": [
    {
      "name": "a2a_start",
      "canvas_id": "trigger",
      "type": "A2A_START",
      "module": "nodes.a2a_start",
      "title": "Order",
      "timeout": 60,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "input_mode": "json",
        "state_key": "wf",
        "output_variable": "order",
        "payload_schema": {
          "fields": [
            {
              "name": "sku",
              "type": "string",
              "description": "What was ordered",
              "required": true
            },
            {
              "name": "qty",
              "type": "integer",
              "description": "How many",
              "required": true
            },
            {
              "name": "gift_message",
              "type": "string",
              "description": "Optional note for the recipient",
              "required": false
            }
          ]
        }
      },
      "is_entry": true
    },
    {
      "name": "n_end_1",
      "canvas_id": "done",
      "type": "END",
      "module": "nodes.n_end_1",
      "title": "Done",
      "timeout": 60,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "output_mapping": {}
      },
      "is_terminal": true
    },
    {
      "name": "n_transform_2",
      "canvas_id": "invoice",
      "type": "TRANSFORM",
      "module": "nodes.n_transform_2",
      "title": "Invoice Line",
      "timeout": 60,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "mode": "fields",
        "output_variable": "invoice",
        "output_fields": [
          {
            "name": "item",
            "type": "string",
            "source": "data.product_code",
            "required": true
          },
          {
            "name": "quantity",
            "type": "integer",
            "source": "data.units",
            "required": true
          },
          {
            "name": "ordered_sku",
            "type": "string",
            "source": "vars.order.sku"
          },
          {
            "name": "currency",
            "type": "string",
            "default": "EUR"
          }
        ]
      }
    },
    {
      "name": "n_transform_3",
      "canvas_id": "shipment",
      "type": "TRANSFORM",
      "module": "nodes.n_transform_3",
      "title": "Shipment",
      "timeout": 60,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "mode": "fields",
        "output_variable": "shipment",
        "output_fields": [
          {
            "name": "product_code",
            "type": "string",
            "source": "data.sku",
            "required": true
          },
          {
            "name": "units",
            "type": "integer",
            "source": "data.qty",
            "required": true
          },
          {
            "name": "quantity_label",
            "type": "string",
            "source": "data.qty"
          },
          {
            "name": "carrier",
            "type": "string",
            "default": "standard-post"
          },
          {
            "name": "gift_message",
            "type": "string",
            "source": "data.gift_message"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "START",
      "to": "a2a_start",
      "route": null
    },
    {
      "from": "a2a_start",
      "to": "n_transform_3",
      "route": null
    },
    {
      "from": "n_transform_2",
      "to": "n_end_1",
      "route": null
    },
    {
      "from": "n_transform_3",
      "to": "n_transform_2",
      "route": null
    }
  ],
  "join_nodes": [],
  "env_keys": [
    {
      "key": "PORT",
      "required": false,
      "needed_by": [
        "serving"
      ],
      "default": "8080",
      "description": "Port the agent listens on."
    },
    {
      "key": "AGENT_NAME",
      "required": true,
      "needed_by": [
        "agent_card"
      ],
      "default": "field_mapping",
      "description": "Advertised agent name."
    },
    {
      "key": "AGENT_DESCRIPTION",
      "required": true,
      "needed_by": [
        "agent_card"
      ],
      "description": "Advertised description."
    },
    {
      "key": "AGENT_VERSION",
      "required": true,
      "needed_by": [
        "agent_card"
      ],
      "default": "1.0.0",
      "description": "Advertised version."
    },
    {
      "key": "CLOUD_RUN_URL",
      "required": false,
      "needed_by": [
        "agent_card"
      ],
      "default": "",
      "description": "Public base URL; becomes the agent card's url. Blank falls back to localhost."
    },
    {
      "key": "A2A_AUTH_TOKEN",
      "required": false,
      "needed_by": [
        "inbound_auth"
      ],
      "description": "When set, callers must send this as a bearer token and the agent card advertises that it is required.",
      "secret": true
    },
    {
      "key": "TASK_STORE_DSN",
      "required": false,
      "needed_by": [
        "task_persistence"
      ],
      "description": "SQLAlchemy async DSN. Blank uses an in-memory store, so tasks/get only works within one process and in-flight tasks are lost on restart.",
      "secret": true
    }
  ]
}
