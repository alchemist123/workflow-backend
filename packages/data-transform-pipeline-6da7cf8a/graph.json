{
  "schema_version": 1,
  "workflow": {
    "name": "Data Transform Pipeline",
    "slug": "data_transform_pipeline",
    "description": "Chains two TRANSFORM nodes: JMESPath extraction then Jinja2 formatting.",
    "version_id": "6da7cf8a-059a-410f-a570-fcf28b1e5457",
    "canvas_version": 7
  },
  "entry_node": "a2a_start",
  "terminal_node": "n_end_1",
  "nodes": [
    {
      "name": "a2a_start",
      "canvas_id": "trigger",
      "type": "A2A_START",
      "module": "nodes.a2a_start",
      "title": "Start",
      "timeout": 60,
      "retries": 1,
      "on_error": "fail",
      "description": "POST /run with {\"user\": {\"name\": \"...\", \"email\": \"...\"}, \"items\": [...], \"total\": N}",
      "config": {
        "input_mode": "json",
        "state_key": "wf",
        "payload_schema": {
          "fields": [
            {
              "name": "items",
              "type": "array",
              "description": "Records to process",
              "required": true
            }
          ]
        }
      },
      "is_entry": true
    },
    {
      "name": "n_end_1",
      "canvas_id": "end",
      "type": "END",
      "module": "nodes.n_end_1",
      "title": "Done",
      "timeout": 30,
      "retries": 1,
      "on_error": "fail",
      "is_terminal": true
    },
    {
      "name": "n_transform_2",
      "canvas_id": "extract",
      "type": "TRANSFORM",
      "module": "nodes.n_transform_2",
      "title": "Extract Fields",
      "timeout": 30,
      "retries": 1,
      "on_error": "fail",
      "description": "JMESPath: flatten nested user + aggregate items",
      "config": {
        "mode": "jmespath",
        "expression": "{name: user.name, email: user.email, item_count: length(items), total: total}"
      }
    },
    {
      "name": "n_transform_3",
      "canvas_id": "format",
      "type": "TRANSFORM",
      "module": "nodes.n_transform_3",
      "title": "Format Output",
      "timeout": 30,
      "retries": 1,
      "on_error": "fail",
      "description": "Jinja2: render a human-readable summary",
      "config": {
        "mode": "jinja2",
        "expression": "{\"greeting\": \"Hello {{ name }}!\", \"email\": \"{{ email }}\", \"summary\": \"You have {{ item_count }} items totalling {{ total }}.\"}"
      }
    }
  ],
  "edges": [
    {
      "from": "START",
      "to": "a2a_start",
      "route": null
    },
    {
      "from": "a2a_start",
      "to": "n_transform_2",
      "route": null
    },
    {
      "from": "n_transform_2",
      "to": "n_transform_3",
      "route": null
    },
    {
      "from": "n_transform_3",
      "to": "n_end_1",
      "route": null
    }
  ],
  "join_nodes": [],
  "env_keys": [
    {
      "key": "PORT",
      "required": false,
      "needed_by": [
        "serving"
      ],
      "default": "8080",
      "description": "Port the agent listens on."
    },
    {
      "key": "AGENT_NAME",
      "required": true,
      "needed_by": [
        "agent_card"
      ],
      "default": "data_transform_pipeline",
      "description": "Advertised agent name."
    },
    {
      "key": "AGENT_DESCRIPTION",
      "required": true,
      "needed_by": [
        "agent_card"
      ],
      "description": "Advertised description."
    },
    {
      "key": "AGENT_VERSION",
      "required": true,
      "needed_by": [
        "agent_card"
      ],
      "default": "1.0.0",
      "description": "Advertised version."
    },
    {
      "key": "CLOUD_RUN_URL",
      "required": false,
      "needed_by": [
        "agent_card"
      ],
      "default": "",
      "description": "Public base URL; becomes the agent card's url. Blank falls back to localhost."
    },
    {
      "key": "A2A_AUTH_TOKEN",
      "required": false,
      "needed_by": [
        "inbound_auth"
      ],
      "description": "When set, callers must send this as a bearer token and the agent card advertises that it is required.",
      "secret": true
    },
    {
      "key": "TASK_STORE_DSN",
      "required": false,
      "needed_by": [
        "task_persistence"
      ],
      "description": "SQLAlchemy async DSN. Blank uses an in-memory store, so tasks/get only works within one process and in-flight tasks are lost on restart.",
      "secret": true
    }
  ]
}
