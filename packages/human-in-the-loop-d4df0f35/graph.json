{
  "schema_version": 1,
  "workflow": {
    "name": "Human In The Loop",
    "slug": "human_in_the_loop",
    "description": "Approve, reject, or supply values \u2014 an expense gate followed by an input request, both pausing the A2A task.",
    "version_id": "d4df0f35-a977-4ac3-98ac-753909d30b6c",
    "canvas_version": 6
  },
  "entry_node": "a2a_start",
  "terminal_node": "n_end_4",
  "nodes": [
    {
      "name": "a2a_start",
      "canvas_id": "trigger",
      "type": "A2A_START",
      "module": "nodes.a2a_start",
      "title": "Expense Request",
      "timeout": 120,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "input_mode": "json",
        "state_key": "wf",
        "payload_schema": {
          "fields": [
            {
              "name": "amount",
              "type": "number",
              "description": "Amount being claimed",
              "required": true
            },
            {
              "name": "reason",
              "type": "text",
              "description": "What the money is for",
              "required": true
            }
          ]
        }
      },
      "is_entry": true
    },
    {
      "name": "n_condition_7",
      "canvas_id": "size",
      "type": "CONDITION",
      "module": "nodes.n_condition_7",
      "title": "Needs approval?",
      "timeout": 120,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "branches": [
          {
            "name": "large",
            "expression": "data.get('amount', 0) >= 1000"
          },
          {
            "name": "small",
            "expression": "True"
          }
        ]
      },
      "routes": [
        "large",
        "small"
      ]
    },
    {
      "name": "n_end_4",
      "canvas_id": "end",
      "type": "END",
      "module": "nodes.n_end_4",
      "title": "End",
      "timeout": 120,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "output_mapping": {}
      },
      "is_terminal": true
    },
    {
      "name": "n_human_approval_5",
      "canvas_id": "gate",
      "type": "HUMAN_APPROVAL",
      "module": "nodes.n_human_approval_5",
      "title": "Finance Sign-off",
      "timeout": 120,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "prompt": "This expense is over the auto-approval limit. Approve it?",
        "assignees": [
          "finance@example.com"
        ],
        "collect_fields": {
          "fields": [
            {
              "name": "cost_centre",
              "type": "string",
              "description": "Which cost centre to charge",
              "required": true
            }
          ]
        }
      },
      "routes": [
        "approved",
        "rejected"
      ]
    },
    {
      "name": "n_human_input_3",
      "canvas_id": "details",
      "type": "HUMAN_INPUT",
      "module": "nodes.n_human_input_3",
      "title": "Payment Details",
      "timeout": 120,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "prompt": "Approved. Where should this be paid from, and when?",
        "assignees": [
          "accounts@example.com"
        ],
        "collect_fields": {
          "fields": [
            {
              "name": "account",
              "type": "string",
              "description": "Account to pay from",
              "required": true
            },
            {
              "name": "pay_on",
              "type": "string",
              "description": "Date to pay (YYYY-MM-DD)",
              "required": true
            },
            {
              "name": "note",
              "type": "text",
              "description": "Anything the payment run should know",
              "required": false
            }
          ]
        }
      }
    },
    {
      "name": "n_transform_1",
      "canvas_id": "auto",
      "type": "TRANSFORM",
      "module": "nodes.n_transform_1",
      "title": "Auto-approve",
      "timeout": 120,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "mode": "python",
        "expression": "result = {'outcome': 'paid', 'approved_by': 'policy'}"
      }
    },
    {
      "name": "n_transform_2",
      "canvas_id": "declined",
      "type": "TRANSFORM",
      "module": "nodes.n_transform_2",
      "title": "Record Decline",
      "timeout": 120,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "mode": "python",
        "expression": "result = {'outcome': 'declined', 'why': data.get('comment')}"
      }
    },
    {
      "name": "n_transform_6",
      "canvas_id": "paid",
      "type": "TRANSFORM",
      "module": "nodes.n_transform_6",
      "title": "Record Payment",
      "timeout": 120,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "mode": "python",
        "expression": "result = {'outcome': 'paid', 'cost_centre': data.get('cost_centre'), 'account': data.get('account'), 'pay_on': data.get('pay_on'), 'approved_by': 'finance'}"
      }
    }
  ],
  "edges": [
    {
      "from": "START",
      "to": "a2a_start",
      "route": null
    },
    {
      "from": "a2a_start",
      "to": "n_condition_7",
      "route": null
    },
    {
      "from": "n_condition_7",
      "to": "n_human_approval_5",
      "route": "large"
    },
    {
      "from": "n_condition_7",
      "to": "n_transform_1",
      "route": "small"
    },
    {
      "from": "n_human_approval_5",
      "to": "n_human_input_3",
      "route": "approved"
    },
    {
      "from": "n_human_approval_5",
      "to": "n_transform_2",
      "route": "rejected"
    },
    {
      "from": "n_human_input_3",
      "to": "n_transform_6",
      "route": null
    },
    {
      "from": "n_transform_1",
      "to": "n_end_4",
      "route": null
    },
    {
      "from": "n_transform_2",
      "to": "n_end_4",
      "route": null
    },
    {
      "from": "n_transform_6",
      "to": "n_end_4",
      "route": null
    }
  ],
  "join_nodes": [],
  "env_keys": [
    {
      "key": "PORT",
      "required": false,
      "needed_by": [
        "serving"
      ],
      "default": "8080",
      "description": "Port the agent listens on."
    },
    {
      "key": "AGENT_NAME",
      "required": true,
      "needed_by": [
        "agent_card"
      ],
      "default": "human_in_the_loop",
      "description": "Advertised agent name."
    },
    {
      "key": "AGENT_DESCRIPTION",
      "required": true,
      "needed_by": [
        "agent_card"
      ],
      "description": "Advertised description."
    },
    {
      "key": "AGENT_VERSION",
      "required": true,
      "needed_by": [
        "agent_card"
      ],
      "default": "1.0.0",
      "description": "Advertised version."
    },
    {
      "key": "CLOUD_RUN_URL",
      "required": false,
      "needed_by": [
        "agent_card"
      ],
      "default": "",
      "description": "Public base URL; becomes the agent card's url. Blank falls back to localhost."
    },
    {
      "key": "A2A_AUTH_TOKEN",
      "required": false,
      "needed_by": [
        "inbound_auth"
      ],
      "description": "When set, callers must send this as a bearer token and the agent card advertises that it is required.",
      "secret": true
    },
    {
      "key": "TASK_STORE_DSN",
      "required": false,
      "needed_by": [
        "task_persistence"
      ],
      "description": "SQLAlchemy async DSN. Blank uses an in-memory store, so tasks/get only works within one process and in-flight tasks are lost on restart.",
      "secret": true
    }
  ]
}
