{
  "schema_version": 1,
  "workflow": {
    "name": "Wait",
    "slug": "wait",
    "description": "Two branches each pausing, to show a wait does not hold up the branch beside it.",
    "version_id": "606bf52f-c1e6-4008-aa19-5df12fb93c41",
    "canvas_version": 6
  },
  "entry_node": "a2a_start",
  "terminal_node": "n_end_3",
  "nodes": [
    {
      "name": "a2a_start",
      "canvas_id": "trigger",
      "type": "A2A_START",
      "module": "nodes.a2a_start",
      "title": "Start",
      "timeout": 120,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "input_mode": "json",
        "state_key": "wf",
        "payload_schema": {
          "fields": [
            {
              "name": "order_id",
              "type": "string",
              "description": "Order to settle",
              "required": true
            }
          ]
        }
      },
      "is_entry": true
    },
    {
      "name": "n_end_3",
      "canvas_id": "end",
      "type": "END",
      "module": "nodes.n_end_3",
      "title": "End",
      "timeout": 120,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "output_mapping": {}
      },
      "is_terminal": true
    },
    {
      "name": "n_merge_5",
      "canvas_id": "join",
      "type": "MERGE",
      "module": "nodes.n_merge_5",
      "title": "Join",
      "timeout": 120,
      "retries": 1,
      "on_error": "fail",
      "is_join": true
    },
    {
      "name": "n_parallel_fork_4",
      "canvas_id": "fork",
      "type": "PARALLEL_FORK",
      "module": "nodes.n_parallel_fork_4",
      "title": "Split",
      "timeout": 120,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "branches": [
          "poll",
          "notify"
        ]
      }
    },
    {
      "name": "n_transform_1",
      "canvas_id": "checked",
      "type": "TRANSFORM",
      "module": "nodes.n_transform_1",
      "title": "Check Status",
      "timeout": 120,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "mode": "python",
        "expression": "result = {'status': 'settled'}"
      }
    },
    {
      "name": "n_transform_6",
      "canvas_id": "sent",
      "type": "TRANSFORM",
      "module": "nodes.n_transform_6",
      "title": "Send Receipt",
      "timeout": 120,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "mode": "python",
        "expression": "result = {'receipt': 'sent'}"
      }
    },
    {
      "name": "n_wait_2",
      "canvas_id": "cooloff",
      "type": "WAIT",
      "module": "nodes.n_wait_2",
      "title": "Rate limit",
      "timeout": 120,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "duration": 1,
        "unit": "seconds"
      }
    },
    {
      "name": "n_wait_7",
      "canvas_id": "settle",
      "type": "WAIT",
      "module": "nodes.n_wait_7",
      "title": "Let it settle",
      "timeout": 120,
      "retries": 1,
      "on_error": "fail",
      "config": {
        "duration": 3,
        "unit": "seconds"
      }
    }
  ],
  "edges": [
    {
      "from": "START",
      "to": "a2a_start",
      "route": null
    },
    {
      "from": "a2a_start",
      "to": "n_parallel_fork_4",
      "route": null
    },
    {
      "from": "n_merge_5",
      "to": "n_end_3",
      "route": null
    },
    {
      "from": "n_parallel_fork_4",
      "to": "n_wait_7",
      "route": null
    },
    {
      "from": "n_parallel_fork_4",
      "to": "n_wait_2",
      "route": null
    },
    {
      "from": "n_transform_1",
      "to": "n_merge_5",
      "route": null
    },
    {
      "from": "n_transform_6",
      "to": "n_merge_5",
      "route": null
    },
    {
      "from": "n_wait_2",
      "to": "n_transform_6",
      "route": null
    },
    {
      "from": "n_wait_7",
      "to": "n_transform_1",
      "route": null
    }
  ],
  "join_nodes": [
    "n_merge_5"
  ],
  "env_keys": [
    {
      "key": "PORT",
      "required": false,
      "needed_by": [
        "serving"
      ],
      "default": "8080",
      "description": "Port the agent listens on."
    },
    {
      "key": "AGENT_NAME",
      "required": true,
      "needed_by": [
        "agent_card"
      ],
      "default": "wait",
      "description": "Advertised agent name."
    },
    {
      "key": "AGENT_DESCRIPTION",
      "required": true,
      "needed_by": [
        "agent_card"
      ],
      "description": "Advertised description."
    },
    {
      "key": "AGENT_VERSION",
      "required": true,
      "needed_by": [
        "agent_card"
      ],
      "default": "1.0.0",
      "description": "Advertised version."
    },
    {
      "key": "CLOUD_RUN_URL",
      "required": false,
      "needed_by": [
        "agent_card"
      ],
      "default": "",
      "description": "Public base URL; becomes the agent card's url. Blank falls back to localhost."
    },
    {
      "key": "A2A_AUTH_TOKEN",
      "required": false,
      "needed_by": [
        "inbound_auth"
      ],
      "description": "When set, callers must send this as a bearer token and the agent card advertises that it is required.",
      "secret": true
    },
    {
      "key": "TASK_STORE_DSN",
      "required": false,
      "needed_by": [
        "task_persistence"
      ],
      "description": "SQLAlchemy async DSN. Blank uses an in-memory store, so tasks/get only works within one process and in-flight tasks are lost on restart.",
      "secret": true
    }
  ]
}
